# Copy to `.env` and fill in. Never commit the real values.

# --- Smile.io -----------------------------------------------------------
# Private API key from Smile Admin. Server-side only: this must never be
# exposed to the browser or inlined into the frontend bundle.
SMILE_API_KEY=
SMILE_API_BASE_URL=https://api.smile.io/v1

# The sample customer's Smile ID. Stands in for a real auth system, which the
# brief explicitly does not require.
SMILE_CUSTOMER_ID=

# --- Challenge store / rate limiting ------------------------------------
# Upstash Redis (HTTP), used to hold single-use math challenges and rate-limit
# counters. Both are TTL-based, so no relational database is needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- CORS ---------------------------------------------------------------
# Production origin of the frontend. Leave unset locally: the Vite dev proxy
# makes requests same-origin.
WEB_ORIGIN=

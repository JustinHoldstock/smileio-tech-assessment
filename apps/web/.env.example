# Copy to `.env` and fill in as needed. Never commit the real values.
#
# NOTE: anything prefixed with `VITE_` is inlined into the client bundle and is
# therefore PUBLIC. The Smile API key must never appear in this file.

# Base URL for API calls. Leave unset to use the relative `/api` path, which is
# served by the Vite dev proxy locally and by a Vercel rewrite in production.
# Only set this if the frontend calls the API deployment directly (which then
# also requires WEB_ORIGIN to be set on the API side for CORS).
VITE_API_BASE_URL=
